<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Slice.Controls.TimelineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource PrLayer1Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource PrTrackHeaderBrush}" BorderBrush="{ThemeResource PrBorderBrush}" BorderThickness="0,0,1,1" />
        <Canvas x:Name="Ruler" Grid.Row="0" Grid.Column="1" Background="{ThemeResource PrLayer1Brush}" />

        <Grid Grid.Row="1" Grid.Column="0" Background="{ThemeResource PrTrackHeaderBrush}" BorderBrush="{ThemeResource PrBorderBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="7,0" BorderBrush="{ThemeResource PrBorderBrush}" BorderThickness="0,0,1,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="20" Background="{ThemeResource PrAccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="V1" FontSize="9" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="Video 1" FontSize="9" Foreground="{ThemeResource PrTextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="1" Padding="7,0" BorderBrush="{ThemeResource PrBorderBrush}" BorderThickness="0,0,1,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="20" Background="{ThemeResource PrAccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="A1" FontSize="9" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="Audio 1" FontSize="9" Foreground="{ThemeResource PrTextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Background="{ThemeResource PrLayer1Brush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{ThemeResource PrBorderBrush}" BorderThickness="0,0,0,1" />
            <Canvas x:Name="Surface" Grid.RowSpan="2" Background="Transparent" />
        </Grid>
    </Grid>
</UserControl>
