<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Slice.Controls.TimelineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Height="116" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <RowDefinition Height="82" />
        </Grid.RowDefinitions>

        <Canvas
            x:Name="Ruler"
            Grid.Row="0"
            Background="Transparent" />

        <Border
            Grid.Row="1"
            Background="#15171B"
            BorderBrush="#2A2D33"
            BorderThickness="1"
            CornerRadius="8">
            <Canvas
                x:Name="Surface"
                Background="Transparent" />
        </Border>
    </Grid>
</UserControl>
