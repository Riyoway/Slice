<UserControl
    x:Class="Slice.Controls.TimelineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Height="76" Background="Transparent">
        <Border
            x:Name="TrackBorder"
            Height="48"
            VerticalAlignment="Center"
            Background="#17191D"
            BorderBrush="#2A2D33"
            BorderThickness="1"
            CornerRadius="8">
            <Canvas
                x:Name="Surface"
                Background="Transparent"
                PointerPressed="Surface_PointerPressed"
                PointerMoved="Surface_PointerMoved"
                PointerReleased="Surface_PointerReleased"
                PointerCanceled="Surface_PointerCanceled"
                SizeChanged="Surface_SizeChanged" />
        </Border>
    </Grid>
</UserControl>
