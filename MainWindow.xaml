<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Slice.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:Slice.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Slice"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" RequestedTheme="Dark" AllowDrop="True" Background="{ThemeResource PrBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="330" />
        </Grid.RowDefinitions>

        <!-- Premiere-style application/menu bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="8,0,144,0" Background="{ThemeResource PrLayer1Brush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Center">
                <Image Source="Assets/AppIcon.png" Width="18" Height="18" />
                <TextBlock Text="Slice" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="File" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="Edit" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="Clip" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="Sequence" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="View" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="Window" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="Help" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock
                x:Name="FileNameText"
                Grid.Column="1"
                Text="Untitled"
                FontSize="11"
                Foreground="{ThemeResource PrTextMutedBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Button x:Name="ThemeToggleButton" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Switch light / dark theme">
                    <Image x:Name="ThemeToggleIcon" Source="Assets/Icons/sun.svg" Width="15" Height="15" />
                </Button>
                <Button x:Name="OpenButton" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Open video (Ctrl+O)">
                    <Image Source="Assets/Icons/folder-open.svg" Width="16" Height="16" />
                </Button>
                <Button x:Name="ExportButton" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Image Source="Assets/Icons/download.svg" Width="14" Height="14" />
                        <TextBlock Text="Export" Foreground="White" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Premiere Import / Edit / Export mode strip -->
        <Grid Grid.Row="1" Background="{ThemeResource PrLayer2Brush}" BorderBrush="{ThemeResource PrBorderBrush}" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                <TextBlock Text="Import" FontSize="12" Foreground="{ThemeResource PrTextMutedBrush}" VerticalAlignment="Center" />
                <Grid Width="36">
                    <TextBlock Text="Edit" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Rectangle Height="2" Fill="{ThemeResource PrAccentBrush}" VerticalAlignment="Bottom" />
                </Grid>
                <TextBlock Text="Export" FontSize="12" Foreground="{ThemeResource PrTextMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Upper editing workspace: Project / Program / Properties -->
        <Grid Grid.Row="2" Margin="4,4,4,2" ColumnSpacing="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <!-- Project panel -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="9,0,7,0" Background="{ThemeResource PrLayer2Brush}" BorderBrush="{ThemeResource PrBorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Project: Slice" Style="{StaticResource PanelHeaderTextStyle}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="7,5" Background="{ThemeResource PrLayer3Brush}" BorderBrush="{ThemeResource PrBorderBrush}" BorderThickness="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="Assets/Icons/search.svg" Width="13" Height="13" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Search" FontSize="10" Foreground="{ThemeResource PrTextDimBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="6,2,6,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Background="{ThemeResource PrLayer2Brush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="62" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" Margin="8,0" FontSize="10" Foreground="{ThemeResource PrTextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Duration" FontSize="10" Foreground="{ThemeResource PrTextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="1" x:Name="ProjectClipRow" Height="34" Visibility="Collapsed" Background="{ThemeResource PrLayer1Brush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="62" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="8,0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Rectangle Width="12" Height="12" Fill="{ThemeResource PrVideoClipBrush}" />
                                <TextBlock x:Name="ProjectClipNameText" Text="Media" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="160" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ProjectDurationText" Grid.Column="1" Text="00:00" FontSize="10" Foreground="{ThemeResource PrTextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel x:Name="ProjectEmptyState" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="No media" FontSize="11" Foreground="{ThemeResource PrTextMutedBrush}" HorizontalAlignment="Center" />
                            <Button x:Name="EmptyOpenButton" Content="Import media" FontSize="11" Padding="10,4" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Program monitor -->
            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="38" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="9,0,7,0" Background="{ThemeResource PrLayer2Brush}" BorderBrush="{ThemeResource PrBorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Program: Sequence 01" Style="{StaticResource PanelHeaderTextStyle}" />
                    </Grid>
                    <Grid Grid.Row="1" x:Name="DropSurface" Background="{ThemeResource PrMonitorBrush}">
                        <MediaPlayerElement
                            x:Name="PlayerElement"
                            AreTransportControlsEnabled="False"
                            Stretch="Uniform"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="Drop media to begin" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="or use File > Open" Foreground="#999999" FontSize="10" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" Padding="8,0" Background="{ThemeResource PrLayer2Brush}" BorderBrush="{ThemeResource PrBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TimeText" Text="00:00:00:00" FontSize="11" Foreground="{ThemeResource PrAccentStrongBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="FrameBackButton" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Previous frame">
                                <Image Source="Assets/Icons/skip-back.svg" Width="14" Height="14" />
                            </Button>
                            <Button x:Name="PlayButton" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Play / pause (Space)">
                                <Image x:Name="PlayButtonIcon" Source="Assets/Icons/play.svg" Width="15" Height="15" />
                            </Button>
                            <Button x:Name="FrameForwardButton" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Next frame">
                                <Image Source="Assets/Icons/skip-forward.svg" Width="14" Height="14" />
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00:00:00" FontSize="11" Foreground="{ThemeResource PrTextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Properties panel -->
            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="9,0,7,0" Background="{ThemeResource PrLayer2Brush}" BorderBrush="{ThemeResource PrBorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Properties" Style="{StaticResource PanelHeaderTextStyle}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="12,9" Spacing="10">
                        <TextBlock Text="CLIP" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource PrTextDimBrush}" />
                        <TextBlock x:Name="SelectedClipText" Text="No clip selected" FontSize="11" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Source In" FontSize="10" Foreground="{ThemeResource PrTextMutedBrush}" />
                            <TextBlock x:Name="PropertyInText" Grid.Column="1" Text="--:--:--:--" FontSize="10" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Source Out" FontSize="10" Foreground="{ThemeResource PrTextMutedBrush}" />
                            <TextBlock x:Name="PropertyOutText" Grid.Column="1" Text="--:--:--:--" FontSize="10" HorizontalAlignment="Right" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource PrBorderBrush}" Margin="0,4" />
                        <TextBlock Text="AUDIO" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource PrTextDimBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Volume" FontSize="10" Foreground="{ThemeResource PrTextMutedBrush}" VerticalAlignment="Center" />
                            <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" />
                            <TextBlock x:Name="VolumeText" Grid.Column="2" Text="100%" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Premiere-style Timeline panel -->
        <Border Grid.Row="3" Margin="4,1,4,4" Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="31" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="22" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="9,0,7,0" Background="{ThemeResource PrLayer2Brush}" BorderBrush="{ThemeResource PrBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Timeline: Sequence 01" Style="{StaticResource PanelHeaderTextStyle}" />
                        <TextBlock x:Name="ClipCountText" Text="0 clips" FontSize="9" Foreground="{ThemeResource PrTextDimBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Padding="6,0" Background="{ThemeResource PrLayer1Brush}" BorderBrush="{ThemeResource PrBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                        <Button x:Name="SplitButton" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Add edit (S)" IsEnabled="False">
                            <Image Source="Assets/Icons/scissors.svg" Width="15" Height="15" />
                        </Button>
                        <Button x:Name="DeleteButton" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Delete selected clip (Delete)" IsEnabled="False">
                            <Image Source="Assets/Icons/trash.svg" Width="15" Height="15" />
                        </Button>
                        <Button x:Name="UndoButton" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Undo (Ctrl+Z)" IsEnabled="False">
                            <Image Source="Assets/Icons/undo-2.svg" Width="15" Height="15" />
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Drag edges to trim  •  Drag clips to reorder  •  S to add edit" FontSize="9" Foreground="{ThemeResource PrTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <controls:TimelineControl x:Name="Timeline" Grid.Row="2" IsEnabled="False" />

                <Grid Grid.Row="3" Padding="7,0" Background="{ThemeResource PrLayer2Brush}" BorderBrush="{ThemeResource PrBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="9" Foreground="{ThemeResource PrTextDimBrush}" VerticalAlignment="Center" />
                    <ProgressBar x:Name="ExportProgress" Grid.Column="1" Width="150" Height="2" Minimum="0" Maximum="1" Value="0" Visibility="Collapsed" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
